<script>


// ============================================================
// FRONTEND JAVASCRIPT
// ============================================================


const promptBox =
document.getElementById(
  "prompt"
);


const generateButton =
document.getElementById(
  "generate"
);


const preview =
document.getElementById(
  "preview"
);


const status =
document.getElementById(
  "status"
);


const download =
document.getElementById(
  "download"
);


const size =
document.getElementById(
  "size"
);


const quality =
document.getElementById(
  "quality"
);


const background =
document.getElementById(
  "background"
);


let generatedImage = null;



// QUICK PROMPTS

document
.querySelectorAll(
  ".quick button"
)
.forEach(
  button => {

    button.addEventListener(
      "click",
      () => {

        promptBox.value =
          button.dataset.prompt;

        promptBox.focus();

      }
    );

  }
);



// GENERATE IMAGE

generateButton.addEventListener(
  "click",
  async () => {


    const prompt =
      promptBox.value.trim();



    if(!prompt){

      status.textContent =
        "Please enter a prompt.";

      promptBox.focus();

      return;

    }



    generateButton.disabled =
      true;


    generateButton.textContent =
      "Creating image... ✦";


    download.disabled =
      true;


    status.textContent =
      "AI is creating your image...";



    preview.innerHTML = `

      <div class="empty">

        <div class="star">
          ✦
        </div>

        <strong>
          Generating...
        </strong>

        <small>
          Please wait.
        </small>

      </div>

    `;



    try{


      const response =
        await fetch(
          "/api/generate",
          {

            method:"POST",

            headers:{
              "Content-Type":
              "application/json"
            },

            body:JSON.stringify({

              prompt:prompt,

              size:size.value,

              quality:quality.value,

              background:
              background.value

            })

          }
        );



      const data =
        await response.json();



      if(!response.ok){

        throw new Error(
          data.error ||
          "Image generation failed."
        );

      }



      generatedImage =
        data.image;



      const image =
        document.createElement(
          "img"
        );


      image.src =
        generatedImage;


      image.alt =
        "SHRYA LUXE AI generated image";



      preview.innerHTML =
        "";


      preview.appendChild(
        image
      );



      status.textContent =
        "Image generated successfully.";


      download.disabled =
        false;



    }catch(error){


      console.error(error);


      status.textContent =
        error.message;



      preview.innerHTML = `

        <div class="empty">

          <div class="star">
            !
          </div>

          <strong>
            Generation failed
          </strong>

          <small>
            ${escapeHTML(error.message)}
          </small>

        </div>

      `;


    }finally{


      generateButton.disabled =
        false;


      generateButton.textContent =
        "Generate Image ✦";

    }

  }
);



// DOWNLOAD IMAGE

download.addEventListener(
  "click",
  () => {


    if(!generatedImage)
      return;



    const link =
      document.createElement(
        "a"
      );


    link.href =
      generatedImage;


    link.download =
      "SHRYA-LUXE-AI.png";


    document.body.appendChild(
      link
    );


    link.click();


    link.remove();

  }
);



// HTML ESCAPE

function escapeHTML(text){

  return String(text)
    .replace(
      /[&<>"']/g,
      character => ({

        "&":"&amp;",
        "<":"&lt;",
        ">":"&gt;",
        '"':"&quot;",
        "'":"&#039;"

      })[character]
    );

}


