<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>SHRYA LUXE AI</title>

  <style>
    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
      font-family:Arial,sans-serif;
    }

    body{
      min-height:100vh;
      background:linear-gradient(135deg,#080808,#181818);
      color:white;
      display:flex;
      justify-content:center;
      align-items:center;
      padding:20px;
    }

    .container{
      width:100%;
      max-width:850px;
      background:#111;
      border:1px solid #333;
      border-radius:25px;
      padding:30px;
      box-shadow:0 20px 60px #000;
    }

    h1{
      text-align:center;
      font-size:35px;
      margin-bottom:8px;
    }

    .logo{
      color:#ffd700;
    }

    .subtitle{
      text-align:center;
      color:#aaa;
      margin-bottom:30px;
    }

    label{
      display:block;
      margin:15px 0 8px;
      font-weight:bold;
    }

    textarea{
      width:100%;
      height:130px;
      resize:none;
      padding:15px;
      border-radius:15px;
      border:1px solid #444;
      background:#1b1b1b;
      color:white;
      font-size:16px;
      outline:none;
    }

    textarea:focus{
      border-color:#ffd700;
    }

    .buttons{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin:10px 0 20px;
    }

    .buttons button{
      padding:10px 15px;
      border:1px solid #444;
      border-radius:20px;
      background:#1c1c1c;
      color:white;
      cursor:pointer;
    }

    .buttons button:hover{
      background:#ffd700;
      color:#000;
    }

    .generate{
      width:100%;
      padding:16px;
      border:0;
      border-radius:15px;
      background:linear-gradient(90deg,#ffd700,#ff9d00);
      color:#000;
      font-size:18px;
      font-weight:bold;
      cursor:pointer;
      margin-top:10px;
    }

    .generate:hover{
      transform:scale(1.01);
    }

    .result{
      margin-top:30px;
      min-height:250px;
      border:1px dashed #444;
      border-radius:20px;
      display:flex;
      justify-content:center;
      align-items:center;
      padding:20px;
      text-align:center;
      color:#888;
    }

    .result img{
      max-width:100%;
      border-radius:15px;
    }

    .download{
      display:none;
      margin:15px auto 0;
      padding:12px 25px;
      border-radius:12px;
      border:0;
      background:white;
      color:black;
      cursor:pointer;
      font-weight:bold;
    }

    select{
      width:100%;
      padding:13px;
      background:#1b1b1b;
      color:white;
      border:1px solid #444;
      border-radius:12px;
    }

    footer{
      text-align:center;
      color:#666;
      margin-top:25px;
      font-size:13px;
    }
  </style>
</head>

<body>

<div class="container">

  <h1>✨ <span class="logo">SHRYA LUXE AI</span></h1>

  <p class="subtitle">
    Create beautiful AI images with your imagination
  </p>

  <label>📝 Enter your prompt</label>

  <textarea id="prompt"
    placeholder="Example: A beautiful Indian girl wearing a red saree, cinematic lighting, ultra realistic..."></textarea>

  <label>⚡ Quick Prompts</label>

  <div class="buttons">
    <button onclick="addPrompt('Luxury fashion portrait')">Luxury</button>
    <button onclick="addPrompt('Cute Indian girl portrait')">Cute</button>
    <button onclick="addPrompt('Beautiful Indian saree photoshoot')">Indian</button>
    <button onclick="addPrompt('Cinematic portrait at night')">Cinematic</button>
    <button onclick="addPrompt('Professional fashion magazine photoshoot')">Fashion</button>
  </div>

  <label>📐 Image Size</label>

  <select id="size">
    <option value="1024x1024">Square 1:1</option>
    <option value="1024x1536">Portrait 2:3</option>
    <option value="1536x1024">Landscape 3:2</option>
  </select>

  <button class="generate" onclick="generateImage()">
    ✨ Generate Image
  </button>

  <div class="result" id="result">
    Your generated image will appear here 👇
  </div>

  <button class="download" id="download" onclick="downloadImage()">
    ⬇️ Download Image
  </button>

  <footer>
    © 2026 SHRYA LUXE AI • Made with ❤️
  </footer>

</div>


<script>

let generatedImage = "";

function addPrompt(text){

  const box = document.getElementById("prompt");

  if(box.value.trim() !== ""){
    box.value += ", " + text;
  }else{
    box.value = text;
  }

}

function generateImage(){

  const prompt = document.getElementById("prompt").value.trim();
  const size = document.getElementById("size").value;
  const result = document.getElementById("result");

  if(!prompt){
    alert("Please enter a prompt first 😊");
    return;
  }

  result.innerHTML = `
    <div>
      <h2>⏳ Creating your image...</h2>
      <p style="margin-top:10px;color:#777">
        Prompt: ${escapeHtml(prompt)}
      </p>
    </div>
  `;

  /*
    IMPORTANT:
    GitHub Pages is static, so actual AI generation
    needs a backend/API.

    Yahan demo ke liye placeholder diya gaya hai.
  */

  setTimeout(() => {

    result.innerHTML = `
      <div>
        <h2>🚀 AI Generator Ready!</h2>
        <p style="margin-top:10px;color:#aaa">
          Your prompt was:
        </p>
        <p style="margin-top:8px;color:#ffd700">
          ${escapeHtml(prompt)}
        </p>
        <p style="margin-top:15px;color:#777">
          Connect your AI backend/API here to generate the real image.
        </p>
      </div>
    `;

  },1000);

}

function escapeHtml(text){

  return text
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");

}

function downloadImage(){

  if(!generatedImage) return;

  const link = document.createElement("a");

  link.href = generatedImage;
  link.download = "shrya-luxe-ai.png";

  link.click();

}

</script>

</body>
</html>
